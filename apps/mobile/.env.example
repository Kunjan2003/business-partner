# Physical phones must use your computer's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional deployed web URL for share links.
EXPO_PUBLIC_WEB_URL=

# EAS project UUID enables Expo push token registration on real device builds.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional client-side crash reporting DSN (public, never Sentry auth token).
EXPO_PUBLIC_SENTRY_DSN=
