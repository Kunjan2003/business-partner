NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-local-anon-key-from-supabase-status

# Optional, restrict this browser key to your production domain.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional public crash reporting DSN. No Sentry auth token in NEXT_PUBLIC values.
NEXT_PUBLIC_SENTRY_DSN=
